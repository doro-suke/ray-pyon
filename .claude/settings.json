{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Cold Edge shared project configuration — このリポジトリ固有の保護のみ。PC全体を守る破壊的コマンド・ホーム配下の資格情報の拒否は ~/.claude/settings.json（グローバル）が正本。",
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)"
    ]
  }
}
